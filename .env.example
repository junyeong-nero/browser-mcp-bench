# Copy to .env (gitignored). Used only by --harness claude-api; billed per token.
ANTHROPIC_API_KEY=sk-ant-...
# Needed only for user keys (sk-ant-usr...) with several workspaces; workspace-scoped
# keys (sk-ant-api03-...) need nothing else. Find IDs in Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
